# --- ANTHROPIC CLAUDE API ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- GOOGLE CALENDAR API (Optional - Falls back to Google Calendar Direct Action Links) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary

# --- EMAIL DISPATCH API (Optional - Falls back to instant live test inbox & mailto) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Voice AI Assistant <your_email@gmail.com>"

# --- STAGE 4: SHARED GOOGLE SHEETS DATABASE ---
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
